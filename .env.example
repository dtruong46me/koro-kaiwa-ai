# ============================================================
# Koro Kaiwa AI — Biến môi trường
# Sao chép file này thành .env và điền giá trị thực.
# KHÔNG commit file .env vào git.
# ============================================================

# --- LLM Provider ---
# Chọn: openai | gemini | anthropic
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- ASR Provider ---
# Chọn: openai_whisper (API cloud) | whisper (local model)
ASR_PROVIDER=openai_whisper
WHISPER_MODEL_SIZE=base           # Chỉ dùng khi ASR_PROVIDER=whisper

# --- TTS Provider ---
# Chọn: openai | voicevox
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=nova                    # alloy | echo | fable | onyx | nova | shimmer

VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=1

# --- NLP ---
# Để trống sẽ bỏ qua bước dịch thuật
GOOGLE_TRANSLATE_KEY=

# --- Session ---
# Chọn: memory | redis
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379
SESSION_TTL=3600

# --- API Server ---
HOST=0.0.0.0
PORT=8000
